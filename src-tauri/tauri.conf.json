{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "harumaeil",
  "version": "0.1.0",
  "identifier": "com.jihyo.harumaeil",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "harumaeil",
        "width": 800,
        "height": 600,
        "label": "main",
        "decorations": false
      },
      {
        "label": "widget",
        "url": "/widget",
        "width": 360,
        "height": 320,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": true,
        "visible": true,
        "minWidth": 240,
        "minHeight": 200
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:harumaeil.db"
      ]
    }
  }
}
